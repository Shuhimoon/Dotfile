# dotfiles: ~/.zshrc template. Deployed only when ~/.zshrc does not exist yet.
# PATH, starship, fzf, rust and go lines are appended by the tools installer as
# "# >>> dotfiles:<tool> >>>" blocks, the same blocks it writes to ~/.bashrc.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt share_history hist_ignore_dups
autoload -Uz compinit && compinit
